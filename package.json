{
  "name": "cannstatt-cruiser",
  "private": true,
  "version": "0.1.0",
  "description": "Pixel-art endless skate runner through Stuttgart and Bad Cannstatt",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "playtest": "tsx scripts/playtest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
